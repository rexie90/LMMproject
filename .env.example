# Copy this file to .env and fill in your real key. NEVER commit .env.
GOOGLE_API_KEY=your_api_key_here

# Primary model (gemini-2.5-flash returned 404 on this key; use 3.8-flash instead)
GEMINI_MODEL=gemini-3.8-flash

# Fallback model used automatically if primary returns 503/429/timeout
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite

# Second fallback tried if first fallback also fails
GEMINI_FALLBACK_MODEL_2=gemini-3.1-flash-lite
